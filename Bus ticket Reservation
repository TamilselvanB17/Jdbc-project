        );
    }


    // =========================================================
    // 1. SEARCH BUSES
    // =========================================================

    static void searchBuses(
            String source,
            String destination) {

        String sql =
                "SELECT * FROM buses " +
                "WHERE LOWER(source) = LOWER(?) " +
                "AND LOWER(destination) = LOWER(?)";

        try (Connection con = getConnection();
             PreparedStatement ps =
                     con.prepareStatement(sql)) {

            ps.setString(1, source);
            ps.setString(2, destination);

            ResultSet rs =
                    ps.executeQuery();

            boolean found = false;

            System.out.println(
                    "\n=============== AVAILABLE BUSES ===============");

            while (rs.next()) {

                found = true;

                System.out.println(
                        "\nBus ID          : "
                                + rs.getInt("bus_id"));

                System.out.println(
                        "Bus Number      : "
                                + rs.getString("bus_number"));

                System.out.println(
                        "Bus Name        : "
                                + rs.getString("bus_name"));

                System.out.println(
                        "Source          : "
                                + rs.getString("source"));

                System.out.println(
                        "Destination     : "
                                + rs.getString("destination"));

                System.out.println(
                        "Total Seats     : "
                                + rs.getInt("total_seats"));

                System.out.println(
                        "Available Seats : "
                                + rs.getInt("available_seats"));

                System.out.println(
                        "----------------------------------------------");
            }


            if (!found) {

                System.out.println(
                        "No buses found for this route.");
            }

        } catch (SQLException e) {

            System.out.println(
                    "Error: " + e.getMessage());
        }
    }


    // =========================================================
    // 2. SEAT BOOKING
    // TRANSACTION + SEAT AVAILABILITY VALIDATION
    // =========================================================

    static void bookSeat(
            int busId,
            String passengerName,
            String phone,
            String email,
            int seatNumber) {

        Connection con = null;

        try {

            con = getConnection();

            // Start transaction
            con.setAutoCommit(false);


            // -------------------------------------------------
            // CHECK BUS AND LOCK THE ROW
            // -------------------------------------------------

            String busSQL =
                    "SELECT total_seats, available_seats " +
                    "FROM buses " +
                    "WHERE bus_id=? " +
                    "FOR UPDATE";

            int totalSeats;
            int availableSeats;

            try (PreparedStatement ps =
                         con.prepareStatement(busSQL)) {

                ps.setInt(1, busId);

                ResultSet rs =
                        ps.executeQuery();

                if (!rs.next()) {

                    System.out.println(
                            "Bus not found.");

                    con.rollback();

                    return;
                }

                totalSeats =
                        rs.getInt("total_seats");

                availableSeats =
                        rs.getInt("available_seats");
            }


            // -------------------------------------------------
            // SEAT NUMBER VALIDATION
            // -------------------------------------------------

            if (seatNumber < 1 ||
                    seatNumber > totalSeats) {

                System.out.println(
                        "Invalid seat number.");

                System.out.println(
                        "Valid seats: 1 to "
                                + totalSeats);

                con.rollback();

                return;
            }


            // -------------------------------------------------
            // CHECK AVAILABLE SEATS
            // -------------------------------------------------

            if (availableSeats <= 0) {

                System.out.println(
                        "No seats available.");

                con.rollback();

                return;
            }


            // -------------------------------------------------
            // CHECK WHETHER PARTICULAR SEAT IS ALREADY BOOKED
            // -------------------------------------------------

            String seatSQL =
                    "SELECT booking_id " +
                    "FROM bookings " +
                    "WHERE bus_id=? " +
                    "AND seat_number=? " +
                    "AND status='BOOKED'";

            try (PreparedStatement ps =
                         con.prepareStatement(seatSQL)) {

                ps.setInt(1, busId);
                ps.setInt(2, seatNumber);

                ResultSet rs =
                        ps.executeQuery();

                if (rs.next()) {

                    System.out.println(
                            "Seat " + seatNumber
                                    + " is already booked.");

                    con.rollback();

                    return;
                }
            }


            // -------------------------------------------------
            // INSERT PASSENGER
            // -------------------------------------------------

            String passengerSQL =
                    "INSERT INTO passengers " +
                    "(passenger_name, phone, email) " +
                    "VALUES (?, ?, ?)";

            int passengerId;

            try (PreparedStatement ps =
                         con.prepareStatement(
                                 passengerSQL,
                                 Statement.RETURN_GENERATED_KEYS)) {

                ps.setString(1, passengerName);
                ps.setString(2, phone);
                ps.setString(3, email);

                ps.executeUpdate();

                ResultSet rs =
                        ps.getGeneratedKeys();

                rs.next();

                passengerId =
                        rs.getInt(1);
            }


            // -------------------------------------------------
            // INSERT BOOKING
            // -------------------------------------------------

            String bookingSQL =
                    "INSERT INTO bookings " +
                    "(bus_id, passenger_id, seat_number, status) " +
                    "VALUES (?, ?, ?, 'BOOKED')";

            int bookingId;

            try (PreparedStatement ps =
                         con.prepareStatement(
                                 bookingSQL,
                                 Statement.RETURN_GENERATED_KEYS)) {

                ps.setInt(1, busId);
                ps.setInt(2, passengerId);
                ps.setInt(3, seatNumber);

                ps.executeUpdate();

                ResultSet rs =
                        ps.getGeneratedKeys();

                rs.next();

                bookingId =
                        rs.getInt(1);
            }


            // -------------------------------------------------
            // UPDATE AVAILABLE SEATS
            // -------------------------------------------------

            String updateSQL =
                    "UPDATE buses " +
                    "SET available_seats = " +
                    "available_seats - 1 " +
                    "WHERE bus_id=?";

            try (PreparedStatement ps =
                         con.prepareStatement(updateSQL)) {

                ps.setInt(1, busId);

                ps.executeUpdate();
            }


            // -------------------------------------------------
            // COMMIT TRANSACTION
            // -------------------------------------------------

            con.commit();


            System.out.println(
                    "\n======================================");

            System.out.println(
                    "       BOOKING SUCCESSFUL");

            System.out.println(
                    "======================================");

            System.out.println(
                    "Booking ID  : "
                            + bookingId);

            System.out.println(
                    "Passenger ID: "
                            + passengerId);

            System.out.println(
                    "Seat Number : "
                            + seatNumber);

            System.out.println(
                    "Status      : BOOKED");

            System.out.println(
                    "======================================");


        } catch (Exception e) {

            System.out.println(
                    "\nBooking failed!");

            System.out.println(
                    "Error: " + e.getMessage());


            try {

                if (con != null) {

                    con.rollback();

                    System.out.println(
                            "Transaction rolled back.");
                }

            } catch (SQLException ex) {

                System.out.println(
                        "Rollback error: "
                                + ex.getMessage());
            }

        } finally {

            try {

                if (con != null) {

                    con.setAutoCommit(true);

                    con.close();
                }

            } catch (SQLException e) {

                System.out.println(
                        "Connection closing error.");
            }
        }
    }


    // =========================================================
    // 3. TICKET CANCELLATION
    // TRANSACTION
    // =========================================================

    static void cancelTicket(int bookingId) {

        Connection con = null;

        try {

            con = getConnection();

            // Start transaction
            con.setAutoCommit(false);


            // -------------------------------------------------
            // GET BOOKING DETAILS
            // -------------------------------------------------

            String selectSQL =
                    "SELECT bus_id, status " +
                    "FROM bookings " +
                    "WHERE booking_id=? " +
                    "FOR UPDATE";

            int busId;
            String status;

            try (PreparedStatement ps =
                         con.prepareStatement(selectSQL)) {

                ps.setInt(1, bookingId);

                ResultSet rs =
                        ps.executeQuery();

                if (!rs.next()) {

                    System.out.println(
                            "Booking not found.");

                    con.rollback();

                    return;
                }

                busId =
                        rs.getInt("bus_id");

                status =
                        rs.getString("status");
            }


            // -------------------------------------------------
            // CHECK BOOKING STATUS
            // -------------------------------------------------

            if (!status.equalsIgnoreCase("BOOKED")) {

                System.out.println(
                        "This ticket is already cancelled.");

                con.rollback();

                return;
            }


            // -------------------------------------------------
            // UPDATE BOOKING STATUS
            // -------------------------------------------------

            String updateBookingSQL =
                    "UPDATE bookings " +
                    "SET status='CANCELLED' " +
                    "WHERE booking_id=?";

            try (PreparedStatement ps =
                         con.prepareStatement(
                                 updateBookingSQL)) {

                ps.setInt(1, bookingId);

                ps.executeUpdate();
            }


            // -------------------------------------------------
            // RETURN SEAT TO BUS
            // -------------------------------------------------

            String updateBusSQL =
                    "UPDATE buses " +
                    "SET available_seats = " +
                    "available_seats + 1 " +
                    "WHERE bus_id=?";

            try (PreparedStatement ps =
                         con.prepareStatement(
                                 updateBusSQL)) {

                ps.setInt(1, busId);

                ps.executeUpdate();
            }


            // -------------------------------------------------
            // COMMIT
            // -------------------------------------------------

            con.commit();

            System.out.println(
                    "\nTicket cancelled successfully!");

            System.out.println(
                    "Seat is now available again.");


        } catch (Exception e) {

            System.out.println(
                    "Cancellation failed!");

            System.out.println(
                    "Error: " + e.getMessage());


            try {

                if (con != null) {

                    con.rollback();

                    System.out.println(
                            "Transaction rolled back.");
                }

            } catch (SQLException ex) {

                System.out.println(
                        "Rollback error: "
                                + ex.getMessage());
            }

        } finally {

            try {

                if (con != null) {

                    con.setAutoCommit(true);

                    con.close();
                }

            } catch (SQLException e) {

                System.out.println(
                        "Connection closing error.");
            }
        }
    }


    // =========================================================
    // 4. PASSENGER DETAILS
    // =========================================================

    static void viewPassengerDetails(
            int passengerId) {

        String sql =
                "SELECT p.passenger_id, " +
                "p.passenger_name, " +
                "p.phone, " +
                "p.email, " +
                "b.booking_id, " +
                "b.seat_number, " +
                "b.status, " +
                "bus.bus_number, " +
                "bus.bus_name, " +
                "bus.source, " +
                "bus.destination " +
                "FROM passengers p " +
                "LEFT JOIN bookings b " +
                "ON p.passenger_id = b.passenger_id " +
                "LEFT JOIN buses bus " +
                "ON b.bus_id = bus.bus_id " +
                "WHERE p.passenger_id=?";


        try (Connection con = getConnection();
             PreparedStatement ps =
                     con.prepareStatement(sql)) {

            ps.setInt(1, passengerId);

            ResultSet rs =
                    ps.executeQuery();


            if (rs.next()) {

                System.out.println(
                        "\n======================================");

                System.out.println(
                        "       PASSENGER DETAILS");

                System.out.println(
                        "======================================");

                System.out.println(
                        "Passenger ID : "
                                + rs.getInt("passenger_id"));

                System.out.println(
                        "Name         : "
                                + rs.getString("passenger_name"));

                System.out.println(
                        "Phone        : "
                                + rs.getString("phone"));

                System.out.println(
                        "Email        : "
                                + rs.getString("email"));

                System.out.println(
                        "Booking ID   : "
                                + rs.getInt("booking_id"));

                System.out.println(
                        "Bus Number   : "
                                + rs.getString("bus_number"));

                System.out.println(
                        "Bus Name     : "
                                + rs.getString("bus_name"));

                System.out.println(
                        "Route        : "
                                + rs.getString("source")
                                + " -> "
