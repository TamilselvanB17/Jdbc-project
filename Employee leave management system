    // =============================================================
    // 7. APPROVE LEAVE - TRANSACTION
    // =============================================================

    static void approveLeave(int leaveId) {

        Connection con = null;

        try {

            con = getConnection();

            // Start transaction
            con.setAutoCommit(false);


            // Get leave request
            String selectSQL =
                    "SELECT employee_id, days, status " +
                    "FROM leave_requests " +
                    "WHERE leave_id=?";

            int employeeId;
            int days;
            String status;

            try (PreparedStatement ps =
                         con.prepareStatement(selectSQL)) {

                ps.setInt(1, leaveId);

                ResultSet rs =
                        ps.executeQuery();

                if (!rs.next()) {

                    System.out.println(
                            "Leave request not found.");

                    con.rollback();

                    return;
                }

                employeeId =
                        rs.getInt("employee_id");

                days =
                        rs.getInt("days");

                status =
                        rs.getString("status");
            }


            // Only pending request can be approved
            if (!status.equalsIgnoreCase("PENDING")) {

                System.out.println(
                        "Only PENDING leave can be approved.");

                con.rollback();

                return;
            }


            // Check leave balance
            String balanceSQL =
                    "SELECT remaining_leaves " +
                    "FROM leave_balance " +
                    "WHERE employee_id=?";

            int remaining;

            try (PreparedStatement ps =
                         con.prepareStatement(balanceSQL)) {

                ps.setInt(1, employeeId);

                ResultSet rs =
                        ps.executeQuery();

                if (!rs.next()) {

                    System.out.println(
                            "Leave balance not found.");

                    con.rollback();

                    return;
                }

                remaining =
                        rs.getInt("remaining_leaves");
            }


            if (days > remaining) {

                System.out.println(
                        "Insufficient leave balance.");

                con.rollback();

                return;
            }


            // Update leave status
            String updateLeaveSQL =
                    "UPDATE leave_requests " +
                    "SET status='APPROVED' " +
                    "WHERE leave_id=?";

            try (PreparedStatement ps =
                         con.prepareStatement(
                                 updateLeaveSQL)) {

                ps.setInt(1, leaveId);

                ps.executeUpdate();
            }


            // Update leave balance
            String updateBalanceSQL =
                    "UPDATE leave_balance " +
                    "SET used_leaves = used_leaves + ?, " +
                    "remaining_leaves = " +
                    "remaining_leaves - ? " +
                    "WHERE employee_id=?";

            try (PreparedStatement ps =
                         con.prepareStatement(
                                 updateBalanceSQL)) {

                ps.setInt(1, days);
                ps.setInt(2, days);
                ps.setInt(3, employeeId);

                ps.executeUpdate();
            }


            // Commit transaction
            con.commit();

            System.out.println(
                    "\nLeave approved successfully!");

            System.out.println(
                    "Leave balance updated successfully!");

        } catch (Exception e) {

            System.out.println(
                    "\nTransaction failed!");

            System.out.println(
                    "Error: " + e.getMessage());

            try {

                if (con != null) {

                    con.rollback();

                    System.out.println(
                            "Transaction rolled back.");
                }

            } catch (SQLException ex) {

                System.out.println(
                        "Rollback error: "
                                + ex.getMessage());
            }

        } finally {

            try {

                if (con != null) {

                    con.setAutoCommit(true);

                    con.close();
                }

            } catch (SQLException e) {

                System.out.println(
                        "Connection close error: "
                                + e.getMessage());
            }
        }
    }


    // =============================================================
    // 8. REJECT LEAVE
    // =============================================================

    static void rejectLeave(int leaveId) {

        String checkSQL =
                "SELECT status " +
                "FROM leave_requests " +
                "WHERE leave_id=?";

        String updateSQL =
                "UPDATE leave_requests " +
                "SET status='REJECTED' " +
                "WHERE leave_id=?";

        try (Connection con = getConnection();
             PreparedStatement checkPS =
                     con.prepareStatement(checkSQL)) {

            checkPS.setInt(1, leaveId);

            ResultSet rs =
                    checkPS.executeQuery();

            if (!rs.next()) {

                System.out.println(
                        "Leave request not found.");

                return;
            }


            String status =
                    rs.getString("status");


            if (!status.equalsIgnoreCase("PENDING")) {

                System.out.println(
                        "Only PENDING leave can be rejected.");

                return;
            }


            try (PreparedStatement updatePS =
                         con.prepareStatement(updateSQL)) {

                updatePS.setInt(1, leaveId);

                updatePS.executeUpdate();

                System.out.println(
                        "Leave rejected successfully!");
            }

        } catch (SQLException e) {

            System.out.println(
                    "Error: " + e.getMessage());
        }
    }


