    // =========================================================
    // 8. SALES REPORT
    // AGGREGATE FUNCTIONS
    // =========================================================

    static void generateSalesReport() {

        String sql =
                "SELECT " +
                "COUNT(*) AS total_sales, " +
                "SUM(quantity) AS total_items, " +
                "SUM(total_amount) AS total_revenue, " +
                "AVG(total_amount) AS average_sale " +
                "FROM sales";


        try (Connection con = getConnection();
             PreparedStatement ps =
                     con.prepareStatement(sql);
             ResultSet rs =
                     ps.executeQuery()) {


            if (rs.next()) {

                System.out.println(
                        "\n==========================================");

                System.out.println(
                        "             SALES REPORT");

                System.out.println(
                        "==========================================");


                System.out.println(
                        "Total Sales       : "
                                + rs.getInt("total_sales"));


                System.out.println(
                        "Items Sold        : "
                                + rs.getInt("total_items"));


                System.out.println(
                        "Total Revenue     : "
                                + rs.getDouble("total_revenue"));


                System.out.println(
                        "Average Sale      : "
                                + rs.getDouble("average_sale"));


                System.out.println(
                        "==========================================");
            }

        } catch (SQLException e) {

            System.out.println(
                    "Error: " + e.getMessage());
        }
    }


    // =========================================================
    // 9. INVENTORY REPORT
    // AGGREGATE FUNCTIONS
    // =========================================================

    static void generateInventoryReport() {

        String sql =
                "SELECT " +
                "COUNT(*) AS total_products, " +
                "SUM(stock) AS total_stock, " +
                "AVG(price) AS average_price, " +
                "SUM(stock * price) AS inventory_value " +
                "FROM products";


        try (Connection con = getConnection();
             PreparedStatement ps =
                     con.prepareStatement(sql);
             ResultSet rs =
                     ps.executeQuery()) {


            if (rs.next()) {

                System.out.println(
                        "\n==========================================");

                System.out.println(
                        "           INVENTORY REPORT");

                System.out.println(
                        "==========================================");


                System.out.println(
                        "Total Products    : "
                                + rs.getInt("total_products"));


                System.out.println(
                        "Total Stock       : "
                                + rs.getInt("total_stock"));


                System.out.println(
                        "Average Price     : "
                                + rs.getDouble("average_price"));


                System.out.println(
                        "Inventory Value   : "
                                + rs.getDouble("inventory_value"));


